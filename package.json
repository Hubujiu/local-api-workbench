{
  "name": "local-api-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/core.mjs && node --check public/app.js",
    "format": "prettier --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"public/*\" \"desktop/*.{mjs,cjs,json}\" \"*.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"public/*\" \"desktop/*.{mjs,cjs,json}\" \"*.json\" \".github/workflows/*.yml\"",
    "build:markdown": "node scripts/build-markdown.mjs",
    "build:sandbox": "node scripts/build-sandbox-libraries.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@msgpack/msgpack": "3.1.2",
    "@smithy/signature-v4": "5.7.4",
    "@xmldom/xmldom": "0.9.12",
    "hawk": "9.0.2",
    "markdown-it": "15.0.3",
    "mongodb": "7.7.0",
    "mysql2": "3.24.6",
    "pg": "8.16.3",
    "quickjs-emscripten": "0.31.0",
    "tough-cookie": "6.0.2",
    "xpath": "0.0.35",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "chai": "6.3.0",
    "crypto-js": "4.2.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2"
  }
}
