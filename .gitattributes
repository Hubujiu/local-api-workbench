/src/vendor/url-sdk.js -text
/src/vendor/url-sdk-host.js -text
/src/vendor/url-sdk-manifest.json -text
/src/vendor/URL-SDK-LICENSES.txt -text
/src/vendor/url-sdk-facade.js -text
/src/vendor/url-sdk-facade-manifest.json -text
/src/script-url-facade.mjs text eol=lf
/src/script-url-runtime.mjs text eol=lf
/src/script-url-state.mjs text eol=lf
# Preserve the licensed Mock bundle's exact-byte integrity on Windows checkout.
/src/vendor/native-mock-library.js -text
/src/vendor/native-mock-library.json -text
/src/vendor/APIPOST-MOCK-LICENSE.txt -text
# Native XML has an exact-source manifest and a reproducible private bundle.
/scripts/sandbox-intrinsic-guard.mjs text eol=lf
/scripts/sandbox-native-xml-entry.mjs text eol=lf
/src/native-xml-path.mjs text eol=lf
/src/vendor/native-xml-library.js -text
/src/vendor/native-xml-library.json -text
/src/vendor/NATIVE-XML-LICENSES.txt -text
